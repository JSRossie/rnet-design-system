# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# cdn.rossie.net serves the JR / R—Net design system under the /charts-and-vectors/
# namespace; the domain root is reserved for future, unrelated content.
# Cross-origin loads (style-guide.html, R—Net) REQUIRE CORS.

# Fonts — subset-stable; content never changes under a given filename.
/charts-and-vectors/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

# CSS and tokens are published under two non-overlapping prefixes so each
# request path matches exactly one rule below. (Cloudflare Pages concatenates
# the headers of every matching rule rather than letting a later rule override
# an earlier one — so overlapping rules would merge into a contradictory
# Cache-Control. Keep these prefixes disjoint.)

# Rolling v1 channel — tracks the latest v1.x in place, so updates must
# propagate: revalidate instead of caching immutably.
/charts-and-vectors/css/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/charts-and-vectors/tokens/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Pinned release snapshots — frozen at release; cache forever.
/charts-and-vectors/css/pinned/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/charts-and-vectors/tokens/pinned/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

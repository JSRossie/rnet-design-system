# Font build toolchain — recreate with fonts/build-fonts.sh setup line
fonts/.venv/
# Env
.env

# Wrangler build cache
.wrangler/

# macOS
.DS_Store

# Scratch / exploratory samples — not part of the system
.temp/

# Staging area for incoming files before integration
.staging/

# CDN: the v1 channel CSS/tokens are generated at deploy by cdn/build.sh from
# the canonical root files. Pinned snapshots (css/v1.N.N/) stay committed.
cdn/charts-and-vectors/css/v1/
cdn/charts-and-vectors/tokens/v1/
# Personal hook config (machine-specific memory path)
.claude/settings.local.json
